#!/usr/bin/env bash
# =============================================================================
# RaBbLE pre-commit hook — block AI tooling symlinks from being committed.
# Installed into each member repo's .git/hooks/ by spells/install-hooks.sh.
#
# CLAUDE.md, CODEX.md, and GEMINI.md are generated symlinks → AGENT.md.
# They are gitignored and must never be committed. If they appear in staging
# it means they were previously tracked (before gitignore was wired) and need
# git rm --cached.
#
# This hook exits non-zero to abort the commit if any are staged.
# =============================================================================

BLOCKED=(CLAUDE.md CODEX.md GEMINI.md)
FOUND=()

for f in "${BLOCKED[@]}"; do
  # Only block if the file is being added/modified (not deleted)
  status=$(git diff --cached --name-status | awk -v f="$f" '$2 == f {print $1}')
  if [[ "$status" == A || "$status" == M ]]; then
    FOUND+=("$f")
  fi
done

if [[ ${#FOUND[@]} -gt 0 ]]; then
  echo ""
  echo "  ✗ pre-commit: AI tooling symlinks must not be committed:" >&2
  for f in "${FOUND[@]}"; do
    echo "      $f" >&2
  done
  echo "" >&2
  echo "  Fix: git rm --cached ${FOUND[*]}" >&2
  echo "       These files are gitignored and regenerated by setup." >&2
  echo "" >&2
  exit 1
fi

# ── Grimoire drift check (self-healing front line) ───────────────────────────
# Warn-only. Runs ONLY in the Grimoire repo (where grimoire-doctor.sh exists),
# and only when docs/gists are staged. Surfaces broken nav links, unindexed
# docs, stale gists, and a stale "door" the moment they're committed — without
# blocking the commit. Make it blocking with `--strict` here if desired.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -x "$ROOT/spells/grimoire-doctor.sh" ]] \
   && git diff --cached --name-only | grep -qE '\.md$|^gist/'; then
  "$ROOT/spells/grimoire-doctor.sh" --quiet || true
fi

# ── Anti-clobber backstop (auto-register + warn) ─────────────────────────────
# Built from spec: log/HANDOFF-PreCommit-AntiClobber.md
# Self-adopting: every commit auto-registers its scope so the NEXT session can
# warn on overlap. Never aborts the commit. This is the backstop for when
# session-start.sh was skipped; session-start.sh remains the front line.
# NOTE: warnings go to fd 3. They used to go to fd 2, which the group's own 2>/dev/null
# swallowed, so this backstop never actually warned anyone.
# Entire block wrapped in || true — a buggy hook that blocks commits is worse
# than the problem it solves.
{
  # 1. Locate Grimoire relative to this member repo
  _HOOK_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
  _HOOK_GRIMOIRE=""
  for _p in \
    "$_HOOK_ROOT/RaBbLE-Grimoire" \
    "$(dirname "$_HOOK_ROOT")/RaBbLE-Grimoire" \
    "$_HOOK_ROOT/../RaBbLE-Grimoire"; do
    [[ -d "$_p/spells" ]] && _HOOK_GRIMOIRE="$(cd "$_p" && pwd)" && break
  done
  [[ -z "$_HOOK_GRIMOIRE" ]] && exit 0

  # claims are runtime state (untracked): they used to churn 66 tracked files in log/agents/
  _HOOK_AGENTS="${RABBLE_AGENTS_DIR:-${RABBLE_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/rabble}/agents}"
  mkdir -p "$_HOOK_AGENTS"
  _HOOK_REPO="$(basename "$_HOOK_ROOT")"
  _HOOK_NOW=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  _HOOK_NOW_SECS=$(date +%s)

  # 2. Who am I? Exact, from the process tree (spells/lib/session-id.sh); works for
  # claude, rabble, codex, gemini... A commit from a plain terminal has no session: skip.
  # shellcheck source=/dev/null
  source "$_HOOK_GRIMOIRE/spells/lib/session-id.sh" 2>/dev/null || exit 0
  _HOOK_SID=$(rabble_sid 2>/dev/null) || exit 0
  [[ -z "$_HOOK_SID" ]] && exit 0

  # 3. Collect staged paths as member-prefixed scopes (RaBbLE-World:world/js/foo.js)
  _HOOK_STAGED=$(git diff --cached --name-only 2>/dev/null)
  [[ -z "$_HOOK_STAGED" ]] && exit 0
  _HOOK_SCOPES=()
  while IFS= read -r _path; do
    [[ -z "$_path" ]] && continue
    _HOOK_SCOPES+=("${_HOOK_REPO}:${_path}")
  done <<< "$_HOOK_STAGED"

  # 3b. Is this staged work mine? A file last written BEFORE this session started was not
  # written by this session; if another session is live it may be that session's work in
  # progress (S290 swept S291's sCoRE edits into one commit this way). Warn, never block.
  _HOOK_START=$(rabble_session_started 2>/dev/null || true)
  _HOOK_PEERS=$(rabble_live_peers 2>/dev/null || true)
  if [[ -n "$_HOOK_START" && -n "$_HOOK_PEERS" ]]; then
    _old=()
    while IFS= read -r _path; do
      [[ -f "$_HOOK_ROOT/$_path" ]] || continue
      [[ "$(stat -c %Y "$_HOOK_ROOT/$_path" 2>/dev/null || echo "$_HOOK_START")" -lt "$_HOOK_START" ]] && _old+=("$_path")
    done <<< "$_HOOK_STAGED"
    if [[ ${#_old[@]} -gt 0 ]]; then
      echo "" >&3
      echo "  ⚠ pre-commit: ${#_old[@]} staged file(s) predate this session, and other sessions are live." >&3
      echo "    This session did not write them; a live session may still be working on them:" >&3
      printf '      %s\n' "${_old[@]:0:8}" >&3
      [[ ${#_old[@]} -gt 8 ]] && echo "      ... and $(( ${#_old[@]} - 8 )) more" >&3
      echo "    Live: $(cut -f5,6,1 <<<"$_HOOK_PEERS" | awk -F'\t' '{printf "%s(%s/%s) ", substr($1,1,8), $2, $3}')" >&3
      echo "    Commit proceeds. Unstage with: git restore --staged <file>" >&3
    fi
  fi

  # 4. Check overlap with OTHER live sessions → print WARNING (never exit non-zero)
  command -v jq &>/dev/null && {
    for _other in "$_HOOK_AGENTS"/*.json; do
      [[ -f "$_other" ]] || continue
      _other_sid=$(basename "$_other" .json)
      [[ "$_other_sid" == "$_HOOK_SID" ]] && continue
      _hb=$(jq -r '.heartbeat_at // .started_at // ""' "$_other" 2>/dev/null)
      [[ -z "$_hb" ]] && continue
      _age=$(( _HOOK_NOW_SECS - $(date -d "$_hb" +%s 2>/dev/null || echo 0) ))
      [[ "$_age" -gt 900 ]] && continue  # dead — skip

      while IFS= read -r _their_scope; do
        [[ -z "$_their_scope" ]] && continue
        _their_path="${_their_scope#*:}"
        for _my_scope in "${_HOOK_SCOPES[@]}"; do
          _my_path="${_my_scope#*:}"
          if [[ "$_my_path" == "$_their_path"* || "$_their_path" == "$_my_path"* \
             || "$_my_scope" == "$_their_scope" ]]; then
            echo "" >&3
            echo "  ⚠ pre-commit: CLOBBER WARNING — another live session holds overlapping scope" >&3
            echo "    Other session : $_other_sid" >&3
            echo "    Their scope   : $_their_scope" >&3
            echo "    Your path     : $_my_scope" >&3
            echo "    Commit proceeds — coordinate if this was unintentional." >&3
          fi
        done
      done < <(jq -r '.scopes[] // empty' "$_other" 2>/dev/null || true)
    done
  }

  # 5. Auto-register staged scope (advisory, self-expiring, auto:true).
  # Merges into existing claim if present; creates a new one otherwise.
  command -v jq &>/dev/null || exit 0
  _HOOK_SCOPES_JSON=$(printf '%s\n' "${_HOOK_SCOPES[@]}" | jq -R . | jq -s '.')
  _HOOK_CLAIM="$_HOOK_AGENTS/${_HOOK_SID}.json"
  if [[ -f "$_HOOK_CLAIM" ]]; then
    _ctmp=$(mktemp)
    jq --argjson s "$_HOOK_SCOPES_JSON" --arg t "$_HOOK_NOW" \
      '.scopes = (.scopes + $s | unique) | .heartbeat_at = $t | .auto = (.auto // true)' \
      "$_HOOK_CLAIM" > "$_ctmp" && mv "$_ctmp" "$_HOOK_CLAIM"
  else
    jq -n \
      --arg sid "$_HOOK_SID" \
      --arg cwd "$(pwd)" \
      --argjson scopes "$_HOOK_SCOPES_JSON" \
      --arg t "$_HOOK_NOW" \
      '{session_id:$sid,agent:"auto",cwd:$cwd,scopes:$scopes,
        started_at:$t,heartbeat_at:$t,auto:true}' \
      > "$_HOOK_CLAIM"
  fi
} 3>&2 2>/dev/null || true   # fd 3 = the real stderr: warnings reach the terminal, internal noise does not

exit 0
