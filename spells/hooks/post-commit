#!/usr/bin/env bash
# =============================================================================
# RaBbLE post-commit hook — agent-agnostic provenance + auto-breadcrumb.
# Installed into each member repo's .git/hooks/ by spells/install-hooks.sh.
# Fires for ANY agent that commits (git-level, not .claude-specific).
#
# Who committed is resolved from the process tree (spells/lib/session-id.sh), not
# from "the newest transcript for this cwd" (which filed commits under whichever
# session wrote last). Records, best-effort and never failing the commit:
#   1. a `commit` event in the committing session's own log/sessions/*.jsonl
#      (repo, hash, subject, harness, provider, model)
#   2. a provisional token-ledger row if the session has none yet
# A commit made from a plain terminal (no agent ancestor) records nothing.
# =============================================================================
{
  G=""
  for p in ./RaBbLE-Grimoire ../RaBbLE-Grimoire .; do
    [[ -f "$p/spells/lib/session-log.sh" && -f "$p/log/token-ledger.tsv" ]] && G="$(cd "$p" && pwd)" && break
  done
  [[ -z "$G" ]] && exit 0
  GRIMOIRE_ROOT="$G"
  # shellcheck source=/dev/null
  source "$G/spells/lib/session-log.sh"

  rec=$(rabble_session_json 2>/dev/null) || exit 0
  SID=$(jq -r .key <<<"$rec")
  [[ -n "$SID" ]] || exit 0

  msg=$(git log -1 --pretty=%s 2>/dev/null)
  hash=$(git rev-parse --short HEAD 2>/dev/null)
  repo=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")
  rabble_log_event commit "repo=$repo" "hash=$hash" "subject=$msg"

  # provisional ledger row (explicit end-session rows always win); serialised with end-session
  exec 9>"$G/log/.lock"
  flock -w 5 9 || exit 0
  grep -q "^$SID	" "$G/log/token-ledger.tsv" 2>/dev/null && exit 0
  organ=$(printf '%s' "$msg" | sed -n 's/.* ~ \([^ ]*\) >>.*/\1/p'); [[ -z "$organ" ]] && organ="(untagged)"
  rev=$(printf '%s' "$msg" | sed -n 's/.*>> \(.*\) \/\/.*/\1/p')
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$SID" "$organ" "auto: ${rev:-$msg}" \
    "$(jq -r .harness <<<"$rec")" "$(jq -r .provider <<<"$rec")" "$(jq -r .model <<<"$rec")" >> "$G/log/token-ledger.tsv"
} >/dev/null 2>&1 || true
exit 0
